import heapq

# Goal state
goal = (1, 2, 3,
        8, 0, 4,
        7, 6, 5)

# 0 represents blank


# Heuristic 1: Misplaced Tiles
def misplaced(state):
    count = 0

    for i in range(9):
        if state[i] != 0 and state[i] != goal[i]:
            count += 1

    return count


# Heuristic 2: Manhattan Distance
def manhattan(state):
    distance = 0

    for i in range(9):
        tile = state[i]

        if tile != 0:
            current_row = i // 3
            current_col = i % 3

            goal_index = goal.index(tile)

            goal_row = goal_index // 3
            goal_col = goal_index % 3

            distance += abs(current_row - goal_row)
            distance += abs(current_col - goal_col)

    return distance


# Generate next states
def neighbors(state):
    result = []

    blank = state.index(0)

    row = blank // 3
    col = blank % 3

    moves = [
        (-1, 0),   # up
        (1, 0),    # down
        (0, -1),   # left
        (0, 1)     # right
    ]

    for dr, dc in moves:

        new_row = row + dr
        new_col = col + dc

        if 0 <= new_row < 3 and 0 <= new_col < 3:

            new_blank = new_row * 3 + new_col

            new_state = list(state)

            # Swap blank with tile
            new_state[blank], new_state[new_blank] = \
                new_state[new_blank], new_state[blank]

            result.append(tuple(new_state))

    return result


# A* Algorithm
def astar(start, heuristic):

    pq = []

    # (f, g, state, path)
    heapq.heappush(pq, (heuristic(start), 0, start, []))

    visited = set()

    while pq:

        f, g, state, path = heapq.heappop(pq)

        if state in visited:
            continue

        visited.add(state)

        path = path + [state]

        # Goal reached
        if state == goal:
            return path

        # Generate next states
        for next_state in neighbors(state):

            if next_state not in visited:

                new_g = g + 1
                new_f = new_g + heuristic(next_state)

                heapq.heappush(
                    pq,
                    (new_f, new_g, next_state, path)
                )

    return None


# Print puzzle
def print_puzzle(state):

    for i in range(0, 9, 3):
        print(state[i], state[i + 1], state[i + 2])

    print()


# Input
start = (
    2, 8, 3,
    1, 6, 4,
    7, 0, 5
)


# CASE 1
print("A* using Misplaced Tiles")
print("--------------------------------")

path = astar(start, misplaced)

if path:
    print("Number of moves:", len(path) - 1)

    for state in path:
        print_puzzle(state)

else:
    print("No solution")


# CASE 2
print("A* using Manhattan Distance")
print("--------------------------------")

path = astar(start, manhattan)

if path:
    print("Number of moves:", len(path) - 1)

    for state in path:
        print_puzzle(state)

else:
    print("No solution")

